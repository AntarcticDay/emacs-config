# Ignora tutto ...

*

# ... tranne i file seguenti:

!.gitignore
!README.md
!early-init.el
!init.el

# I moduli della configurazione e i temi personali.
# Servono DUE righe per cartella: senza !lisp/ Git non entrerebbe nemmeno
# nella cartella, e la riga sui file non verrebbe mai valutata.

!lisp/
!lisp/*.el
!themes/
!themes/*.el

# ------------------------------------------------
# ---> Emacs
# -*- mode: gitignore; -*-
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Org-mode
.org-id-locations
*_archive

# flymake-mode
*_flymake.*

# eshell files
/eshell/history
/eshell/lastdir

# elpa packages
/elpa/

# reftex files
*.rel

# AUCTeX auto folder
/auto/

# cask packages
.cask/
dist/

# Flycheck
flycheck_*.el

# server auth directory
/server/

# projectiles files
.projectile

# directory configuration
.dir-locals.el

# network security
/network-security.data

# undo-tree
*.~undo-tree~
